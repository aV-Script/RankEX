<?xml version="1.0" encoding="utf-8"?>
<!--
  Schermata nativa mostrata da MainActivity.showErrorOverlay() quando la WebView
  non riesce a caricare rankex-app.web.app (offline o sito irraggiungibile).
  Non è una pagina web: se la connessione manca del tutto, nessun JS potrebbe
  comunque essere eseguito — vedi CLAUDE.md → sezione mobile-app.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07090e">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <TextView
            android:id="@+id/connection_error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nessuna connessione a Internet."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

        <Button
            android:id="@+id/connection_error_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="RIPROVA"
            android:textColor="#000000"
            android:backgroundTint="#1DFF6B"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />

    </LinearLayout>
</FrameLayout>

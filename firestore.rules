rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function userProfile() {
      let p = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return p == null ? {} : p.data;
    }

    function isSuperAdmin() {
      return isAuth() && userProfile().role == 'super_admin';
    }

    function isClientOfOrg(orgId) {
      return isAuth() &&
        userProfile().role == 'client' &&
        userProfile().orgId == orgId;
    }

    function isOrgMember(orgId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    function memberRole(orgId) {
      let doc = get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
      return doc == null ? null : doc.data.role;
    }

    function canWrite(orgId) {
      return isSuperAdmin() ||
        (isOrgMember(orgId) && memberRole(orgId) in ['org_admin', 'trainer']);
    }

    function canRead(orgId) {
      return isSuperAdmin() || isOrgMember(orgId);
    }

    // ── Limiti piano ─────────────────────────────────────────────
    // Applicati solo nelle Cloud Functions creaCliente / creaMembroTeam
    // (functions/src/shared/plans.js). Il client non crea clienti/membri né
    // tocca memberCount/clientCount: se potesse, aggirerebbe il limite.

    function isOrgAdminForMember(targetUid) {
      let admin = userProfile();
      return isAuth() &&
        admin.role == 'org_admin' &&
        admin.orgId != null &&
        exists(/databases/$(database)/documents/organizations/$(admin.orgId)/members/$(targetUid)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) &&
        request.resource.data.role in ['org_admin', 'trainer', 'staff_readonly'];
    }

    // Regole di sblocco avatar per suffisso — speculari a config/avatars.config.js
    // e functions/src/shared/avatarUnlocks.js (01-03 default, 04-06 a livello,
    // 07-09 solo se acquistati con acquistaAvatar). Prima il cliente poteva
    // impostare qualsiasi avatarId e saltare livello e acquisto.
    function avatarUnlocked(avatarId, client) {
      let level = client.get('level', 1);
      return avatarId is string && (
        !avatarId.matches('.*0[4-9]$') ||
        (avatarId.matches('.*04$') && level >= 5) ||
        (avatarId.matches('.*05$') && level >= 10) ||
        (avatarId.matches('.*06$') && level >= 15) ||
        (avatarId.matches('.*0[7-9]$') && avatarId in client.get('avatarPurchased', []))
      );
    }

    function isOwnClient(orgId, clientId) {
      return isAuth() &&
        userProfile().orgId == orgId &&
        userProfile().clientId == clientId &&
        userProfile().role == 'client';
    }

    // ── Users ─────────────────────────────────────────────────

    match /users/{uid} {
      // Ogni utente legge solo il proprio profilo (o super_admin legge tutto)
      allow read: if isAuth() && (request.auth.uid == uid || isSuperAdmin());

      // CREATE: solo super_admin. I profili di clienti e membri li crea l'Admin SDK
      // (creaCliente / creaMembroTeam). Una regola più larga permetteva a un trainer
      // di creare un profilo con role 'super_admin' per un nuovo account Auth.
      allow create: if isSuperAdmin();

      // UPDATE: super_admin può tutto.
      // L'utente può azzerare solo mustChangePassword (non impostarlo a true).
      // Org_admin può cambiare il role dei propri membri (valori ammessi: vedere isOrgAdminForMember).
      allow update: if isSuperAdmin() ||
        (request.auth.uid == uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['mustChangePassword']) &&
         request.resource.data.mustChangePassword == false) ||
        isOrgAdminForMember(uid);

      allow delete: if isSuperAdmin();
    }

    // ── Organizations ─────────────────────────────────────────

    match /organizations/{orgId} {
      allow read:   if isSuperAdmin() || isOrgMember(orgId) || isClientOfOrg(orgId);
      // create/delete: solo super_admin (CreateOrgForm). Un org_admin che cancella
      // l'org lascerebbe orfani clienti, slot, gruppi e utenti.
      allow create, delete: if isSuperAdmin();
      // org_admin aggiorna i campi descrittivi dell'org. Counter, modulo e piano
      // restano fuori: memberCount/clientCount li muovono solo le Cloud Functions
      // (Admin SDK), moduleType/plan solo super_admin.
      allow update: if isSuperAdmin() ||
        (isOrgMember(orgId) && memberRole(orgId) == 'org_admin' &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberCount', 'clientCount', 'moduleType', 'plan']));

      // ── Members ───────────────────────────────────────────

      match /members/{uid} {
        allow read:   if isSuperAdmin() ||
          (isOrgMember(orgId) && memberRole(orgId) == 'org_admin');
        // create: solo via creaMembroTeam (Admin SDK), che applica il limite piano
        // e incrementa memberCount nello stesso batch.
        allow create: if isSuperAdmin();
        allow update, delete: if isSuperAdmin() ||
          (isOrgMember(orgId) && memberRole(orgId) == 'org_admin');
      }

      // ── Clients ───────────────────────────────────────────

      match /clients/{clientId} {
        allow read:   if canRead(orgId) || isOwnClient(orgId, clientId);
        // create: solo via creaCliente (Admin SDK), che applica il limite piano
        // e incrementa clientCount nello stesso batch.
        allow create: if isSuperAdmin();
        // update diretto: solo i campi che l'app scrive senza Cloud Function.
        // XP, livello, Monete, rank, stats, campionamenti, log, BIA, streak e
        // acquisti li scrivono solo le callable (Admin SDK): prima un trainer
        // poteva modificarli direttamente dalla console del browser.
        //   trainer/org_admin: misure (useMisure), trofei (useBadges), wearable (useWearable)
        //   cliente: vetrina trofei, wearable, avatar — solo se sbloccato
        allow update: if isSuperAdmin() ||
          (canWrite(orgId) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'peso', 'altezza', 'misureHistory',
             'badges', 'badgeShowcase',
             'wearableEnabled', 'wearable',
           ])) ||
          (isOwnClient(orgId, clientId) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wearable', 'avatarId', 'badgeShowcase']) &&
           (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['avatarId']) ||
            avatarUnlocked(request.resource.data.avatarId, resource.data)));
        // delete: solo via eliminaCliente (Admin SDK), che decrementa clientCount
        // e cancella le subcollection e l'account del cliente
        allow delete: if isSuperAdmin();

        // ── Notes (thread + commenti del cliente) ──────────
        // Trainer: legge, crea thread root e commenti, elimina qualsiasi nota.
        // Client: solo lettura delle proprie note — non può scrivere né eliminare.

        match /notes/{noteId} {
          allow read: if canRead(orgId) || isOwnClient(orgId, clientId);

          allow create: if canWrite(orgId);

          allow delete: if canWrite(orgId);

          allow update: if false;
        }

        // ── Obiettivi (target trainer su un test specifico) ─
        // Trainer: crea, annulla (update di stato), legge. Client: solo lettura dei
        // propri obiettivi — motivante vederli, ma non può crearli né modificarli.
        // Lo stato 'achieved' è scritto solo dalla Cloud Function salvaCampionamento
        // (Admin SDK, bypassa le rules) — qui non serve una rule dedicata per quello.

        match /goals/{goalId} {
          allow read: if canRead(orgId) || isOwnClient(orgId, clientId);

          allow create: if canWrite(orgId);

          allow update: if canWrite(orgId);

          allow delete: if false;
        }
      }

      // ── Slots ─────────────────────────────────────────────

      match /slots/{slotId} {
        allow read: if canRead(orgId) ||
          (isClientOfOrg(orgId) &&
           resource.data.clientIds.hasAny([userProfile().clientId]));
        allow write: if canWrite(orgId);
      }

      // ── Groups ────────────────────────────────────────────

      match /groups/{groupId} {
        allow read:  if canRead(orgId);
        allow write: if canWrite(orgId);

        match /notes/{noteId} {
          allow read:   if canRead(orgId);
          allow create: if canWrite(orgId) &&
            request.resource.data.authorId == request.auth.uid;
          allow delete: if canWrite(orgId) &&
            (resource.data.authorId == request.auth.uid ||
             memberRole(orgId) == 'org_admin');
          allow update: if false;
        }
      }

      // ── Recurrences ───────────────────────────────────────

      match /recurrences/{recId} {
        allow read:  if canRead(orgId);
        allow write: if canWrite(orgId);
      }

      // ── Notifications ─────────────────────────────────────

      match /notifications/{notId} {
        allow read: if canRead(orgId) ||
          (isClientOfOrg(orgId) &&
           userProfile().clientId == resource.data.clientId);
        allow create: if canWrite(orgId);
        // Il cliente può solo segnare lette o eliminare le proprie notifiche:
        // prima poteva riscriverne anche clientId e messaggio.
        allow update: if canWrite(orgId) ||
          (isClientOfOrg(orgId) &&
           resource.data.clientId == userProfile().clientId &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']));
        allow delete: if canWrite(orgId) ||
          (isClientOfOrg(orgId) &&
           resource.data.clientId == userProfile().clientId);
      }

      // ── Workout Plans ──────────────────────────────────────
      // Trainer crea e gestisce le schede; client legge solo le schede
      // assegnate a sé (clientId == proprio clientId nel profilo utente).

      match /workoutPlans/{planId} {
        // Il cliente legge solo le schede assegnate a sé. Prima leggeva quelle di
        // tutti i clienti dell'org (dati di allenamento, anche di minori).
        // La query del client filtra già per clientId (getClientPlans), quindi
        // la regola è valutabile anche sulle query.
        allow read: if canRead(orgId) ||
          (isClientOfOrg(orgId) && resource.data.clientId == userProfile().clientId);
        allow create, update, delete:  if canWrite(orgId);
      }
    }

    // ── Audit log ─────────────────────────────────────────────
    // Append-only: ogni utente autenticato può scrivere,
    // solo super_admin legge. Mai modificabile né eliminabile.

    match /audit_logs/{logId} {
      allow read:   if isSuperAdmin();
      // Anti-spoofing (STORY-015/EPIC-007): uid ed email devono corrispondere
      // all'identità autenticata, e nessun campo extra oltre a quelli scritti
      // da utils/auditLog.js — impedisce di iniettare campi come `role` per
      // falsificare il log come "prova" in caso di incidente.
      allow create: if isAuth()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(
             ['action', 'uid', 'email', 'timestamp', 'userAgent', 'details', 'env']
           );
      allow update: if false;
      allow delete: if false;
    }

    // ── Runbook manuale — solo super_admin ───────────────────────
    // Esecuzioni dei casi in config/runbook.config.js (che resta la fonte di
    // verità dei casi stessi — qui vive solo lo storico di chi ha passato cosa).

    match /qa_runs/{runId} {
      allow read, write: if isSuperAdmin();
    }
  }
}
